# Defence in depth: even if a malicious file were somehow written here,
# Apache must never execute it. Files in this directory are served as
# inert static content only.

# Turn off every scripting handler mod_php / CGI might attach.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php5.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pht .shtml .cgi .pl .py .jsp .asp .htm .html
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pht .shtml .cgi .pl .py

# Some cPanel stacks route PHP through suPHP / FCGI, which ignores the above.
<IfModule mod_suphp.c>
    suPHP_Engine off
</IfModule>

# Belt and braces: refuse to serve anything that is not an image.
<FilesMatch "(?i)\.(?!jpe?g$|png$|gif$|webp$)[^.]+$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes
AddType text/plain .php .phtml .phps

# Uploaded content is immutable — its filename is a random hash.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
