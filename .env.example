# MongoDB connection string
# Atlas: Database → Connect → Drivers. URL-encode the password if it contains
# any of : / ? # [ ] @ — otherwise the driver misreads it and auth fails.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database>

# NextAuth secret — run: openssl rand -base64 32
NEXTAUTH_SECRET=<generate_a_random_32_byte_base64_string>

# Base URL of your deployment
NEXTAUTH_URL=http://localhost:3000

# Resend email service
RESEND_API_KEY=re_<your_resend_api_key>
RESEND_FROM_EMAIL=Your Name <noreply@yourdomain.com>

# Admin panel access — comma-separate for multiple admins
ADMIN_EMAIL=admin@yourdomain.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourdomain.com
