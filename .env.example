# MongoDB connection string
# Atlas: Database → Connect → Drivers. URL-encode the password if it contains
# any of : / ? # [ ] @ — otherwise the driver misreads it and auth fails.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database>

# NextAuth secret — run: openssl rand -base64 32
NEXTAUTH_SECRET=<generate_a_random_32_byte_base64_string>

# Base URL of your deployment
NEXTAUTH_URL=http://localhost:3000

# Resend email service
RESEND_API_KEY=re_<your_resend_api_key>
RESEND_FROM_EMAIL=Your Name <noreply@yourdomain.com>

# Admin panel access — comma-separate for multiple admins
ADMIN_EMAIL=admin@yourdomain.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourdomain.com

# ── Image uploads on shared hosting (optional) ──────────────────────────────
# Set both to store guest-uploaded images on your own file host instead of
# inline in MongoDB. See shared-host-upload/README.md for setup.
# Leave unset and images fall back to being stored inline.
#
# Must match shared_secret in your host's config.php. Generate with:
#   openssl rand -hex 32
# NOTE: no NEXT_PUBLIC_ prefix — that would publish it in the browser bundle.
UPLOAD_SHARED_SECRET=<generate_a_random_hex_secret>

# Public URL of upload.php on your shared host
NEXT_PUBLIC_UPLOAD_ENDPOINT=https://yourdomain.com/files/upload.php
